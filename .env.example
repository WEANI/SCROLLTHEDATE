# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # PostgreSQL connection string (postgresql://user:pass@host:port/db) — ex. Supabase

# ── Auth (Supabase Auth) ──────────────────────────────────────────
SUPABASE_URL=              # https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY= # Clé privée — backend uniquement, jamais préfixée VITE_ (bypass RLS)
VITE_SUPABASE_URL=         # Même valeur que SUPABASE_URL, exposée au frontend
VITE_SUPABASE_ANON_KEY=    # Clé publique anon — safe côté client

# ── Admin Role ──────────────────────────────────────────────────
OWNER_EMAIL=               # Email qui reçoit le rôle "admin" à sa première connexion — aussi destinataire des alertes admin par email (nouveau message, scénario choisi…)

# ── Email transactionnel (Resend) ─────────────────────────────────
# Facultatif : sans ces 2 variables, l'app démarre normalement et les emails
# sont simplement journalisés en console au lieu d'être envoyés (cf.
# api/lib/email.ts). Le domaine d'EMAIL_FROM doit être vérifié (SPF/DKIM)
# dans le tableau de bord Resend avant le premier envoi réel.
RESEND_API_KEY=            # Clé API Resend (re_xxxxxxxx)
EMAIL_FROM=                # ex. "Scroll The Date <notifications@scrollthedate.com>"

# ── URL publique ──────────────────────────────────────────────────
APP_URL=                   # ex. https://scrollthedate.com — utilisée pour les liens absolus dans les emails ; retombe sur le domaine Railway si absente
